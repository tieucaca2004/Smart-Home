# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file (it is already git-ignored).

PORT=3000

TUYA_ACCESS_ID=your_access_id_here
TUYA_ACCESS_SECRET=your_access_secret_here

# Optional override
# TUYA_ENDPOINT=https://openapi.tuyaus.com

# Comma-separated list of Tuya device ids this hub currently knows about.
# Used by GET /api/devices — see README "Known limitations" for why this
# is explicit configuration rather than dynamic discovery in v1.
# TUYA_DEVICE_IDS=1638018234ab950e1ecd,1638018234ab950e241e
