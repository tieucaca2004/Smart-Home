# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file (it is already git-ignored).

PORT=3000

TUYA_ACCESS_ID=your_access_id_here
TUYA_ACCESS_SECRET=your_access_secret_here

# Optional override
# TUYA_ENDPOINT=https://openapi.tuyaus.com

# Optional. The Hub lists EVERY device the Tuya Cloud project can see
# (GET /v1.0/iot-01/associated-users/devices), so you normally need nothing here.
# Set TUYA_DISCOVERY=off to disable that and list only TUYA_DEVICE_IDS.
# TUYA_DISCOVERY=off

# Optional. Comma-separated Tuya device ids that are always listed, looked up one
# by one with "Query Device Details" (the original, live-tested path). Devices
# listed here and found by discovery are shown once. See README "Device discovery".
# TUYA_DEVICE_IDS=1638018234ab950e1ecd,1638018234ab950e241e

# Optional. The Hub's location in decimal degrees, used ONLY by automation rules that
# have a sunrise/sunset condition. Leave unset and such rules are rejected (everything
# else works). Set both together.
# HUB_LATITUDE=
# HUB_LONGITUDE=
